{
  "name": "alphaibanez/laminim-service",
  "description": "Laminim Kernel Tools Backend Service",
  "type": "library",
  "version": "0.1.13",
  "require": {
    "php": ">=8.2.0",
    "ext-pdo": "*",
    "ext-curl": "*",
    "ext-intl": "*",
    "ext-openssl": "*",
    "ext-zlib": "*",
    "ext-fileinfo": "*",
    "nikic/fast-route": "^1.3",
    "cocur/slugify": "^4.2",
    "nesbot/carbon": "^2.62",
    "robmorgan/phinx": "^0.16.11",
    "symfony/console": "^7.4",
    "poliander/cron": "^3.0",
    "donatj/phpuseragentparser": "^1.11",
    "phpoffice/phpspreadsheet": "^5.4",
    "phpmailer/phpmailer": "^7.1"
  },
  "require-dev": {
    "aws/aws-sdk-php": "^3.376",
    "influxdata/influxdb-client-php": "^3.8"
  },
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Lkt\\": "src"
    },
    "files": [
      "src/startup.php"
    ]
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
